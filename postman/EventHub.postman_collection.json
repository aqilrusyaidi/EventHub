          "name": "21 Rate limiting: wrong password, send 11 times (429)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Run this one LAST. After it, logins from this computer are blocked for 5 minutes. Restarting the backend clears the block straight away.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"siti@eventhub.com\",\n  \"password\": \"wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Send this request again and again. After 10 failed logins",
                  "// the API answers 429 Too Many Requests for 5 minutes.",
                  "// (In the Collection Runner it repeats by itself.)",
                  "const attempts = Number(pm.collectionVariables.get(\"loginAttempts\") || 0) + 1;",
                  "if (pm.response.code !== 429 && attempts < 12) {",
                  "  pm.collectionVariables.set(\"loginAttempts\", attempts);",
                  "  if (pm.execution && pm.execution.setNextRequest) {",
                  "    pm.execution.setNextRequest(pm.info.requestName);",
                  "  } else {",
                  "    postman.setNextRequest(pm.info.requestName);",
                  "  }",
                  "} else {",
                  "  pm.collectionVariables.set(\"loginAttempts\", 0);",
                  "  pm.test(\"Rate limit reached: status is 429\", function () {",
                  "    pm.response.to.have.status(429);",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
